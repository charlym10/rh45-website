---
import { AboutTabs, DirectionTable } from '@/components/AboutSections';
import BackHome from '@/components/BackHome.astro';
import PageIntro from '@/components/PageIntro.astro';
import { Separator } from '@/components/ui/separator';
import about from '@/data/about.json';
import Layout from '@/layouts/Layout.astro';

const groups = [about.principles, about.values, about.beliefs, about.nonNegotiables];
const direction = [
  { title: 'Purpose', text: 'To redefine how the physical world supports human life.' },
  { title: 'Mission', text: 'To enable the places where people live, work and gather to become autonomous, adaptive and secure⁠—built on foundations designed to evolve.' },
  { title: 'Vision', text: 'A world where the places people inhabit anticipate needs, protect life and adapt over time⁠—coordinating with one another while remaining accountable to the people they serve.' },
];
---

<Layout title="About | Rh45">
  <PageIntro
    label="About Rh45"
    lead="Rh45 is an early-stage company enabling the places where people live, work and gather to become autonomous, adaptive and secure."
  >
    Giving the physical world <em>the ability to think.</em>
  </PageIntro>
  <div class="pb-12">
    <div class="shell">
      <div class="grid grid-cols-2 gap-12 max-[860px]:grid-cols-1">
        <div class="[&_p]:mb-4">
          <h2>Why we exist</h2>
          <p>The places where humanity lives were never designed to think. As physical environments become more complex, disconnected systems and reactive operations are no longer enough.</p>
          <p>We believe intelligence should extend beyond screens and isolated applications. It should be embedded in the environments themselves&#8288;—distributed across the physical world where life happens, and designed to operate responsibly, securely and with human oversight.</p>
        </div>
        <DirectionTable rows={direction} />
      </div>
      <Separator className="my-12" />
      <AboutTabs client:visible groups={groups} />
      <BackHome />
    </div>
  </div>
</Layout>
