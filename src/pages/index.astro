---
import { ArrowDown, ArrowRight, RefreshCw } from 'lucide-react';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Card, CardContent } from '@/components/ui/card';
import Layout from '@/layouts/Layout.astro';

const cycle = [
  { id: 'sense', number: '01', title: 'Sense', text: 'Understand what is happening across a physical environment.' },
  { id: 'reason', number: '02', title: 'Reason', text: 'Interpret context and determine appropriate responses.' },
  { id: 'coordinate', number: '03', title: 'Coordinate', text: 'Coordinate connected systems, infrastructure and agents.' },
  { id: 'act', number: '04', title: 'Act', text: 'Execute actions autonomously within defined boundaries.' },
];
const conflict = [
  { label: 'The status quo', title: 'Fragmented systems', text: 'Information and action remain separated.' },
  { label: 'The consequence', title: 'Reactive environments', text: 'People still carry the burden of coordination.' },
];
---

<Layout title="Rh45 | Redefining how the physical world supports human life">
  <script is:inline>
    // The company pages used to live at these hashes; keep old links working.
    if (['#manifesto', '#how-we-operate', '#about'].includes(location.hash)) location.replace(`/${location.hash.slice(1)}/`);
  </script>
  <section class="hero relative flex flex-col overflow-hidden">
    <div class="shell relative z-1 flex flex-1 flex-col justify-center py-12">
      <h1>The world around us is changing.<br /><em>Our environments must, too.</em></h1>
      <p class="max-w-[68ch] text-lg leading-7">The places where people live, work and gather remain too often passive, fragmented and reactive&#8288;—even as the systems around them become more complex. Rh45 exists to give the physical world the ability to think, starting with autonomous access.</p>
      <a class={buttonVariants({ variant: 'outline', className: 'mt-6 w-fit border-input shadow-none' })} href="#conflict">See the challenge <ArrowDown /></a>
    </div>
  </section>

  <section class="border-t py-24 max-[620px]:py-12" id="conflict">
    <div class="shell">
      <div class="statement">
        <h2>Connected is not the same as intelligent.</h2>
        <p>Connectivity has brought more devices and data into physical spaces. But isolated systems, delayed responses and fragmented operations can still leave environments unable to understand context or coordinate effectively.</p>
      </div>
      <div class="mt-12 grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-stretch gap-4 max-[620px]:grid-cols-1">
        {
          conflict.map(({ label, title, text }, index) => (
            <>
              {index > 0 && <ArrowRight className="size-4 self-center text-muted-foreground max-[620px]:justify-self-center max-[620px]:rotate-90" aria-hidden="true" />}
              <Card className="shadow-none">
                <CardContent>
                  <Badge className="mb-4" variant="secondary">{label}</Badge>
                  <h3>{title}</h3>
                  <p class="text-sm text-muted-foreground">{text}</p>
                </CardContent>
              </Card>
            </>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-primary py-24 text-primary-foreground max-[620px]:py-12 dark:bg-secondary dark:text-foreground">
    <div class="shell statement">
      <h2>What if the environment itself could understand and respond?</h2>
      <div>
        <p>Not simply by adding another app or dashboard, but by embedding intelligence into the physical world&#8288;—where context, infrastructure and everyday life meet.</p>
        <p class="mt-4 text-sm">Rh45 is at an early stage. This site shares our direction and how we work as we build our first project, focused on autonomous access.</p>
      </div>
    </div>
  </section>

  <section class="py-24 max-[620px]:py-12" id="cognitive">
    <div class="shell">
      <div class="statement">
        <h2>Intelligence, embedded into the environments where life happens.</h2>
        <p>Rh45’s foundational ambition is to connect the physical world with distributed intelligence, so environments can move beyond isolated automation toward contextual, coordinated action.</p>
      </div>
      <div class="mt-12 grid grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-12 border-t pt-12 max-[720px]:grid-cols-1 max-[720px]:gap-6">
        <div class="sticky top-[calc(var(--nav-height)+1.5rem)] self-start max-[720px]:static">
          <ol class="cycle-rail">
            {
              cycle.map(({ id, title }, index) => (
                <li>
                  <a href={`#${id}`} aria-current={index === 0 ? 'step' : undefined}>{title}</a>
                </li>
              ))
            }
          </ol>
        </div>
        <div>
          {
            cycle.map(({ id, number, title, text }) => (
              <article class="cycle-step border-b py-12 first:pt-0" id={id}>
                <div class="mb-4 font-mono text-[13px] leading-5 text-muted-foreground tabular-nums">{number}</div>
                <h3 class="mb-4 text-3xl leading-9 tracking-[-.01em]">{title}</h3>
                <p class="lead text-foreground">{text}</p>
              </article>
            ))
          }
          <div class="mt-6 flex items-center gap-2 font-medium">
            <RefreshCw className="size-4 flex-none" aria-hidden="true" />
            <span>Each action informs the next cycle</span>
          </div>
          <p class="note">Conceptual model of the infrastructure Rh45 is building&#8288;—not a description of a currently available product.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-secondary py-24 max-[620px]:py-12" id="mission">
    <div class="shell statement">
      <h2>To redefine how the physical world supports human life.</h2>
      <div>
        <p class="lead">To enable the places where people live, work and gather to become autonomous, adaptive and secure&#8288;—built on foundations designed to evolve.</p>
        <a class={buttonVariants({ variant: 'outline', className: 'mt-6 border-input shadow-none' })} href="/about/">Discover Rh45 <ArrowRight /></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { min-height: max(460px, calc(100vh - var(--nav-height))); min-height: max(460px, calc(100svh - var(--nav-height))); }
  .statement { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 3rem; align-items: start; }
  .statement h2 { margin-bottom: 0; }
  .hero::after { content: ""; position: absolute; right: -120px; top: 12%; width: 550px; height: 550px; border: 1px solid color-mix(in srgb, var(--foreground) 30%, transparent); border-radius: 50%; box-shadow: 0 0 0 60px color-mix(in srgb, var(--foreground) 10%, transparent), 0 0 0 120px color-mix(in srgb, var(--foreground) 5%, transparent); }
  .cycle-rail { position: relative; display: flex; flex-direction: column; gap: 1.5rem; }
  .cycle-rail::before { content: ""; position: absolute; left: 3px; top: .5rem; bottom: .5rem; width: 1px; background: var(--foreground); }
  .cycle-rail a { position: relative; display: block; padding-left: 1.5rem; color: var(--muted-foreground); }
  .cycle-rail a::before { content: ""; position: absolute; left: 0; top: .5rem; box-sizing: border-box; width: 7px; height: 7px; border: 1px solid var(--foreground); border-radius: 9999px; background: var(--background); transition: background-color .2s cubic-bezier(.16, 1, .3, 1); }
  .cycle-rail a[aria-current] { color: var(--foreground); font-weight: 600; }
  .cycle-rail a[aria-current]::before { background: var(--foreground); }
  @media (max-width: 860px) {
    .statement { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .cycle-rail { display: none; }
  }
  @media (max-width: 620px) {
    .hero { min-height: max(400px, calc(100vh - var(--nav-height))); min-height: max(400px, calc(100svh - var(--nav-height))); }
  }
</style>

<script>
  // The rail follows the step in the middle of the viewport.
  const railLinks = document.querySelectorAll<HTMLAnchorElement>('.cycle-rail a');
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        railLinks.forEach((link) => {
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'step');
          else link.removeAttribute('aria-current');
        });
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('.cycle-step').forEach((step) => observer.observe(step));
</script>
