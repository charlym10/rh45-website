---
import { ArrowDown, ArrowUpRight, MapPin } from 'lucide-react';
import CopyAddress from '@/components/CopyAddress.astro';
import LanguagePrompt from '@/components/LanguagePrompt.astro';
import { buttonVariants } from '@/components/ui/button';
import { home, homePath, type Lang, ui } from '@/i18n';
import { cn } from '@/lib/utils';
import Layout from '@/layouts/Layout.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
const contactEmail = 'contact@rh45.ai';
const partnerEmail = 'partners@rh45.ai';
const partnerHref = `mailto:${partnerEmail}?subject=${encodeURIComponent(t.partnerSubject)}`;
const secondBeat = 'font-serif font-normal not-italic tracking-normal';
const site = new URL('/', Astro.site);
const pageUrl = new URL(homePath[lang], Astro.site);
// The company carries the long-term vision; the Pereira pilot is a service it offers.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}#organization`,
      name: 'Rh45',
      legalName: 'Rh45 Corp.',
      url: site,
      description: ui[lang].vision,
      email: contactEmail,
      contactPoint: { '@type': 'ContactPoint', contactType: 'design partners', email: partnerEmail, availableLanguage: ['en', 'es'] },
    },
    {
      '@type': 'Service',
      '@id': `${site}#design-partners`,
      name: t.serviceName,
      description: t.serviceDescription,
      provider: { '@id': `${site}#organization` },
      areaServed: { '@type': 'City', name: 'Pereira', containedInPlace: { '@type': 'Country', name: 'Colombia' } },
      availableChannel: { '@type': 'ServiceChannel', serviceUrl: new URL('#design-partners', pageUrl) },
      inLanguage: lang,
    },
  ],
};
---


<Layout title={t.title} lang={lang} alternates={homePath}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  {lang === 'en' && <LanguagePrompt />}
  <section class="hero relative flex items-center overflow-hidden py-16">
    <div class="wrap flex min-w-0 flex-1 items-center gap-12">
      <div class="relative z-1 flex min-w-0 flex-[999_1_520px] flex-col gap-8">
        <h1 class="display m-0 max-w-160">{t.headline[0]} <em>{t.headline[1]}</em></h1>
        <p class="max-w-140 text-xl text-muted-foreground">{t.intro}</p>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
          <a class={cn(buttonVariants(), 'relative after:absolute after:inset-x-0 after:-inset-y-1')} href="#design-partners">
            {t.seeOffer}
            <ArrowDown />
          </a>
          <p class="flex items-center gap-1.5 text-sm font-medium"><MapPin className="size-4 flex-none" aria-hidden="true" />{t.availability}</p>
        </div>
      </div>
      <div class="hero-art min-w-0 flex-[1_1_360px]">
        <svg class="network block w-full text-foreground" viewBox="0 0 440 440" aria-hidden="true">
          <circle cx="220" cy="220" r="219" fill="none" stroke="currentColor" stroke-opacity="0.3" stroke-width="1"></circle>
          <circle class="fill-foreground/4 dark:fill-foreground/12" cx="220" cy="220" r="150"></circle>
          <g stroke="currentColor" stroke-width="1">
            <line data-spoke="A" x1="220" y1="220" x2="120" y2="140" stroke-opacity="0.35"></line>
            <line data-spoke="B" x1="220" y1="220" x2="320" y2="128" stroke-opacity="0.35"></line>
            <line data-spoke="F" x1="220" y1="220" x2="351" y2="197" stroke-opacity="0"></line>
            <line data-spoke="C" x1="220" y1="220" x2="336" y2="268" stroke-opacity="0.35"></line>
            <line data-spoke="D" x1="220" y1="220" x2="168" y2="330" stroke-opacity="0.35"></line>
            <line data-spoke="G" x1="220" y1="220" x2="119" y2="302" stroke-opacity="0"></line>
            <line data-spoke="E" x1="220" y1="220" x2="96" y2="250" stroke-opacity="0.35"></line>
            <line data-edge="A-B" x1="120" y1="140" x2="320" y2="128" stroke-opacity="0.35"></line>
            <line data-edge="B-F" x1="320" y1="128" x2="351" y2="197" stroke-opacity="0"></line>
            <line data-edge="F-C" x1="351" y1="197" x2="336" y2="268" stroke-opacity="0"></line>
            <line data-edge="C-D" x1="336" y1="268" x2="168" y2="330" stroke-opacity="0.35"></line>
            <line data-edge="D-G" x1="168" y1="330" x2="119" y2="302" stroke-opacity="0"></line>
            <line data-edge="G-E" x1="119" y1="302" x2="96" y2="250" stroke-opacity="0"></line>
            <line data-edge="E-A" x1="96" y1="250" x2="120" y2="140" stroke-opacity="0.35"></line>
            <line data-edge="B-C" x1="320" y1="128" x2="336" y2="268" stroke-opacity="0.35"></line>
            <line data-edge="D-E" x1="168" y1="330" x2="96" y2="250" stroke-opacity="0.35"></line>
            <line data-edge="E-B" x1="96" y1="250" x2="320" y2="128" stroke-opacity="0"></line>
            <line data-edge="F-D" x1="351" y1="197" x2="168" y2="330" stroke-opacity="0"></line>
          </g>
          <g class="fill-background" stroke="currentColor" stroke-width="1.5">
            <circle data-node="A" cx="120" cy="140" r="6"></circle>
            <circle data-node="B" cx="320" cy="128" r="6"></circle>
            <circle data-node="F" cx="351" cy="197" r="0" opacity="0"></circle>
            <circle data-node="C" cx="336" cy="268" r="6"></circle>
            <circle data-node="D" cx="168" cy="330" r="6"></circle>
            <circle data-node="G" cx="119" cy="302" r="0" opacity="0"></circle>
            <circle data-node="E" cx="96" cy="250" r="6"></circle>
          </g>
          <circle cx="220" cy="220" r="10" fill="currentColor"></circle>
        </svg>
      </div>
    </div>
  </section>

  <section class="border-t" id="why">
    <div class="wrap labelled">
      <h2 class="section-label">{t.whyLabel}</h2>
      <div class="labelled-content flex flex-col gap-6">
        <p class="statement">{t.whyStatement}</p>
        <p class="max-w-140 text-xl text-muted-foreground">{t.whyText}</p>
      </div>
    </div>
  </section>

  <section class="bg-secondary" id="first">
    <div class="wrap labelled">
      <h2 class="section-label">{t.firstLabel}</h2>
      <div class="labelled-content flex flex-col gap-12">
        <div class="flex flex-col gap-4">
          <h3 class="m-0 text-3xl leading-9 tracking-[-.01em]">{t.firstTitle}</h3>
          <p class="max-w-140 text-xl">{t.firstProblem}</p>
          <p class="max-w-[68ch] text-muted-foreground">{t.firstText}</p>
        </div>
        <div class="flex scroll-mt-6 flex-col gap-6 rounded-lg bg-background p-8 max-[620px]:p-6" id="design-partners">
          <div class="flex flex-col gap-2">
            <h4 class="text-2xl leading-8 font-semibold tracking-[-.01em]">{t.partnersTitle}</h4>
            <p class="flex items-center gap-2 font-medium"><MapPin className="size-4 flex-none" aria-hidden="true" />{t.availability}</p>
            <p class="max-w-[68ch] text-muted-foreground">{t.partnersStage}</p>
          </div>
          <dl class="grid grid-cols-3 gap-6 border-t border-input pt-6 max-[720px]:grid-cols-1">
            {
              t.partnerFacts.map(({ term, detail }) => (
                <div class="flex flex-col gap-1">
                  <dt class="text-sm font-semibold">{term}</dt>
                  <dd class="text-sm text-muted-foreground">{detail}</dd>
                </div>
              ))
            }
          </dl>
          <div class="flex flex-col items-start gap-3">
            <p>{t.partnersPrompt}</p>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <a class={cn(buttonVariants(), 'relative after:absolute after:inset-x-0 after:-inset-y-1')} href={partnerHref}>
                {t.becomePartner}
                <ArrowUpRight />
              </a>
              <p class="text-sm text-muted-foreground">{t.orWriteTo} <span class="whitespace-nowrap"><a class="inline-block py-3 text-foreground underline underline-offset-4" href={partnerHref}>{partnerEmail}</a><CopyAddress class="text-foreground" email={partnerEmail} lang={lang} /></span></p>
            </div>
            <p class="text-sm text-muted-foreground">{t.replyNote}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="principles">
    <div class="wrap labelled">
      <h2 class="section-label">{t.principlesLabel}</h2>
      <ol class="labelled-content border-b">
        {
          t.principles.map(({ title, detail }, index) => (
            <li class="flex items-baseline gap-6 border-t py-6">
              <span class="font-mono text-[13px] leading-5 text-muted-foreground tabular-nums">{String(index + 1).padStart(2, '0')}</span>
              <div class="flex flex-col gap-2">
                <h3 class="principle m-0">{title}</h3>
                <p class="max-w-[60ch] text-muted-foreground">{detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="solid-block flex min-h-[calc(100svh-8.5rem)] -scroll-mt-20 items-center bg-primary text-primary-foreground max-[640px]:min-h-0 max-[640px]:scroll-mt-0 dark:bg-secondary dark:text-foreground" id="contact">
    <div class="wrap flex min-w-0 flex-1 flex-col gap-8 pt-32 pb-24 max-[640px]:py-16">
      <h2 class="display m-0 max-w-180">{t.closing[0]} <em class={secondBeat}>{t.closing[1]}</em></h2>
      <p class="max-w-140 text-xl text-input dark:text-muted-foreground">{t.closingText}</p>
      <div class="flex flex-col items-start gap-2">
        <a class={cn(buttonVariants(), 'relative bg-background text-foreground after:absolute after:inset-x-0 after:-inset-y-1 hover:bg-background/90 dark:bg-foreground dark:text-background dark:hover:bg-foreground/90')} href={partnerHref}>
          {t.becomePartner}
          <ArrowUpRight />
        </a>
        <p class="text-sm text-input dark:text-muted-foreground">{t.orWriteToSentence} <span class="whitespace-nowrap"><a class="inline-block py-3 text-primary-foreground underline underline-offset-4 dark:text-foreground" href={partnerHref}>{partnerEmail}</a>.<CopyAddress class="text-primary-foreground dark:text-foreground" email={partnerEmail} lang={lang} /></span></p>
        <p class="text-sm text-input dark:text-muted-foreground">{t.replyNote}</p>
        <p class="text-sm text-input dark:text-muted-foreground">{t.anythingElse} <span class="whitespace-nowrap"><a class="inline-block py-3 text-primary-foreground underline underline-offset-4 dark:text-foreground" href={`mailto:${contactEmail}`}>{contactEmail}</a><CopyAddress class="text-primary-foreground dark:text-foreground" email={contactEmail} lang={lang} /></span></p>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero { min-height: min(calc(100vh - 80px), 960px); min-height: min(calc(100svh - 80px), 960px); }
  .hero-art { max-width: 440px; }
  .labelled { display: flex; flex-wrap: wrap; gap: 24px 48px; padding-block: 96px; }
  .labelled-content { flex: 999 1 560px; min-width: 0; max-width: 820px; }
  .section-label { flex: 1 1 200px; margin: 0; font-size: 12px; line-height: 16px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; text-wrap: wrap; color: var(--muted-foreground); }
  .statement { font-size: clamp(24px, 3vw, 30px); line-height: 1.25; font-weight: 500; letter-spacing: -.01em; }
  .principle { font-size: clamp(20px, 2.4vw, 24px); line-height: 1.3; font-weight: 500; letter-spacing: -.01em; }
  @media (max-width: 900px) {
    .hero-art { position: absolute; right: -136px; bottom: -68px; width: 480px; max-width: none; opacity: .3; pointer-events: none; }
  }
</style>

<script>
  // The network turns slowly around its hub while nodes join and leave the ring.
  const network = document.querySelector<SVGSVGElement>('.network')!;
  const center = 220;
  const radius = 130;
  const startAngle = (-177.3 * Math.PI) / 180;
  const turnSeconds = 90;
  const eventSeconds = 40;
  const ring = ['A', 'B', 'F', 'C', 'D', 'G', 'E'];
  const motion: Record<string, { period: number; phase: number; offset: number }> = {
    A: { period: 7, phase: 0, offset: 0.1 },
    B: { period: 9, phase: 1.3, offset: -0.09 },
    F: { period: 12, phase: 2.1, offset: 0.07 },
    C: { period: 8, phase: 2.9, offset: -0.12 },
    D: { period: 10, phase: 3.7, offset: 0.08 },
    G: { period: 13, phase: 4.4, offset: -0.06 },
    E: { period: 11, phase: 5.2, offset: 0.11 },
  };
  // When each node fades in (1) or out (0), as [start, end, target] in fractions of the event cycle.
  const events: Record<string, [number, number, number][]> = {
    F: [[0.1, 0.18, 1], [0.88, 0.94, 0]],
    G: [[0.28, 0.36, 1], [0.92, 0.98, 0]],
    A: [[0.46, 0.54, 0], [0.72, 0.78, 1]],
    C: [[0.6, 0.68, 0], [0.8, 0.86, 1]],
  };

  const nodes = [...network.querySelectorAll<SVGCircleElement>('[data-node]')];
  const spokes = [...network.querySelectorAll<SVGLineElement>('[data-spoke]')];
  // An edge only shows while the nodes between its two ends are gone from the ring.
  const edges = [...network.querySelectorAll<SVGLineElement>('[data-edge]')].map((element) => {
    const [a, b] = element.dataset.edge!.split('-');
    const between: string[] = [];
    for (let i = (ring.indexOf(a) + 1) % ring.length; i !== ring.indexOf(b); i = (i + 1) % ring.length) between.push(ring[i]);
    return { element, a, b, between };
  });

  function presence(id: string, cycle: number) {
    const nodeEvents = events[id];
    if (!nodeEvents) return 1;
    let value = nodeEvents[0][2] === 1 ? 0 : 1;
    for (const [start, end, target] of nodeEvents) {
      if (cycle <= start) return value;
      if (cycle < end) {
        const k = (cycle - start) / (end - start);
        return value + (target - value) * k * k * (3 - 2 * k);
      }
      value = target;
    }
    return value;
  }

  function draw(seconds: number) {
    const cycle = (seconds % eventSeconds) / eventSeconds;
    const turn = (seconds / turnSeconds) * 2 * Math.PI;
    const shares = Object.fromEntries(ring.map((id) => [id, presence(id, cycle)]));
    const total = ring.reduce((sum, id) => sum + shares[id], 0);
    const points: Record<string, { x: number; y: number; present: number }> = {};
    let used = 0;
    for (const id of ring) {
      const { period, phase, offset } = motion[id];
      const sway = 0.04 * Math.sin((2 * Math.PI * seconds) / (period * 1.7) + phase);
      const angle = startAngle + turn + (2 * Math.PI * (used + shares[id] / 2)) / total + offset + sway;
      const distance = radius * (1 + 0.12 * Math.sin((2 * Math.PI * seconds) / period + phase));
      used += shares[id];
      points[id] = { x: center + distance * Math.cos(angle), y: center + distance * Math.sin(angle), present: shares[id] };
    }
    for (const node of nodes) {
      const { x, y, present } = points[node.dataset.node!];
      node.setAttribute('cx', x.toFixed(1));
      node.setAttribute('cy', y.toFixed(1));
      node.setAttribute('r', (6 * present).toFixed(2));
      node.setAttribute('opacity', present.toFixed(3));
    }
    for (const spoke of spokes) {
      const { x, y, present } = points[spoke.dataset.spoke!];
      spoke.setAttribute('x2', x.toFixed(1));
      spoke.setAttribute('y2', y.toFixed(1));
      spoke.setAttribute('stroke-opacity', (0.35 * present).toFixed(3));
    }
    for (const { element, a, b, between } of edges) {
      const visible = between.reduce((value, id) => value * (1 - points[id].present), Math.min(points[a].present, points[b].present));
      element.setAttribute('x1', points[a].x.toFixed(1));
      element.setAttribute('y1', points[a].y.toFixed(1));
      element.setAttribute('x2', points[b].x.toFixed(1));
      element.setAttribute('y2', points[b].y.toFixed(1));
      element.setAttribute('stroke-opacity', (0.35 * visible).toFixed(3));
    }
  }

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    draw(0);
  } else {
    const animate = (now: number) => {
      draw(now / 1000);
      requestAnimationFrame(animate);
    };
    requestAnimationFrame(animate);
  }
</script>
