---
import { Globe, X } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
---

<dialog class="language-prompt fixed inset-auto right-6 bottom-6 z-20 m-0 w-[min(calc(100%-3rem),22rem)] rounded-lg border bg-popover p-6 text-popover-foreground shadow-md max-[620px]:right-4 max-[620px]:bottom-4 max-[620px]:w-[calc(100%-2rem)] max-[620px]:py-1.5 max-[620px]:pr-1.5 max-[620px]:pl-4" lang="es" aria-labelledby="language-prompt-title">
  <!-- On a phone the prompt is one line, so it never covers the hero's button. -->
  <div class="flex items-center gap-2 min-[621px]:hidden">
    <Globe className="size-4 flex-none" aria-hidden="true" />
    <span class="mr-auto text-sm font-semibold">¿Prefiere español?</span>
    <a class={cn(buttonVariants({ size: 'sm' }), 'language-prompt-accept relative after:absolute after:inset-x-0 after:-inset-y-1.5')} href="/es/" hreflang="es">Ver en español</a>
    <button class={cn(buttonVariants({ variant: 'ghost', size: 'icon-sm' }), 'language-prompt-dismiss relative cursor-pointer after:absolute after:-inset-1.5')} type="button" aria-label="Cerrar">
      <X />
    </button>
  </div>
  <div class="max-[620px]:hidden">
    <div class="flex items-start justify-between gap-4">
      <p class="flex items-center gap-2 text-base font-semibold" id="language-prompt-title">
        <Globe className="size-4 flex-none" aria-hidden="true" />
        ¿Prefiere leer en español?
      </p>
      <button class={cn(buttonVariants({ variant: 'ghost', size: 'icon-sm' }), 'language-prompt-dismiss relative -mt-1.5 -mr-2 cursor-pointer after:absolute after:-inset-1.5')} type="button" aria-label="Cerrar">
        <X />
      </button>
    </div>
    <p class="mt-2 text-sm text-muted-foreground">Esta página también está disponible en español.</p>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <a class={cn(buttonVariants(), 'language-prompt-accept relative after:absolute after:inset-x-0 after:-inset-y-1')} href="/es/" hreflang="es">Ver en español</a>
      <button class={cn(buttonVariants({ variant: 'ghost' }), 'language-prompt-dismiss relative cursor-pointer after:absolute after:inset-x-0 after:-inset-y-1')} type="button">Seguir en inglés</button>
    </div>
  </div>
</dialog>

<style>
  .language-prompt[open] { animation: prompt-in .3s cubic-bezier(.16, 1, .3, 1); }
  @media (prefers-reduced-motion: reduce) {
    .language-prompt[open] { animation: none; }
  }
  @keyframes prompt-in {
    from { opacity: 0; transform: translateY(.5rem); }
  }
</style>

<script>
  // There is no server to read the visitor's country, so the browser's language and time zone stand in for it.
  const hispanicTimeZones = [
    'America/Argentina/', 'America/Buenos_Aires', 'America/Asuncion', 'America/Bogota', 'America/Caracas', 'America/Chihuahua',
    'America/Ciudad_Juarez', 'America/Costa_Rica', 'America/El_Salvador', 'America/Guatemala', 'America/Guayaquil', 'America/Havana',
    'America/Hermosillo', 'America/La_Paz', 'America/Lima', 'America/Managua', 'America/Matamoros', 'America/Mazatlan',
    'America/Merida', 'America/Mexico_City', 'America/Monterrey', 'America/Montevideo', 'America/Ojinaga', 'America/Panama',
    'America/Puerto_Rico', 'America/Punta_Arenas', 'America/Santiago', 'America/Santo_Domingo', 'America/Tegucigalpa',
    'America/Tijuana', 'America/Bahia_Banderas', 'America/Cancun', 'Atlantic/Canary', 'Africa/Ceuta', 'Africa/Malabo',
    'Europe/Madrid', 'Pacific/Easter', 'Pacific/Galapagos',
  ];

  const prompt = document.querySelector<HTMLDialogElement>('.language-prompt')!;

  function storedLanguage() {
    try {
      return localStorage.getItem('rh45-language');
    } catch {
      return null;
    }
  }

  function remember(language: string) {
    try {
      localStorage.setItem('rh45-language', language);
    } catch {}
  }

  const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone ?? '';
  const speaksSpanish = navigator.languages.some((language) => language.toLowerCase().startsWith('es'));
  const inHispanicCountry = hispanicTimeZones.some((zone) => timeZone === zone || (zone.endsWith('/') && timeZone.startsWith(zone)));

  // Opening through the attribute, not show(), leaves keyboard focus where it was: a suggestion
  // must not move the start of the page's tab order.
  if (!storedLanguage() && (speaksSpanish || inHispanicCountry)) prompt.toggleAttribute('open', true);

  // Closing from inside the prompt hands the keyboard to the page's content.
  function dismiss() {
    const hadFocus = prompt.contains(document.activeElement);
    remember('en');
    prompt.close();
    if (hadFocus) document.getElementById('main')?.focus();
  }

  prompt.querySelectorAll<HTMLAnchorElement>('.language-prompt-accept').forEach((link) =>
    link.addEventListener('click', () => {
      remember('es');
      link.href = `/es/${location.hash}`;
    }),
  );
  prompt.querySelectorAll('.language-prompt-dismiss').forEach((button) => button.addEventListener('click', dismiss));
  // Escape only answers the prompt when the visitor is in it.
  prompt.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') dismiss();
  });
  // It steps aside once it would cover something: on a phone as soon as the visitor starts reading,
  // on a wider screen when the footer reaches it. It is not remembered: the prompt comes back on
  // the next visit, and the header link stays.
  const footer = document.querySelector('footer');
  const onScroll = () => {
    if (!prompt.open) return;
    const reading = window.matchMedia('(max-width: 620px)').matches && window.scrollY >= 200;
    const atFooter = footer !== null && footer.getBoundingClientRect().top < window.innerHeight;
    if (!reading && !atFooter) return;
    prompt.close();
    window.removeEventListener('scroll', onScroll);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
