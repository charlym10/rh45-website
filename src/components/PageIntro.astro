---
interface Props {
  eyebrow: string;
  lead: string;
}

const { eyebrow, lead } = Astro.props;
---

<div class="pt-8 pb-12">
  <div class="shell">
    <div class="mb-2 text-xs font-semibold tracking-[.14em] uppercase">{eyebrow}</div>
    <h1><slot /></h1>
    <p class="lead">{lead}</p>
  </div>
</div>
