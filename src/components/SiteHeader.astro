---
import { ArrowUpRight, Building2, ChevronDown, ChevronRight, House, PanelLeft, X } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';

const companyLinks = [
  { href: '/manifesto/', label: 'Manifesto' },
  { href: '/how-we-operate/', label: 'How we operate' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
const menuItem = 'flex w-full cursor-pointer items-center gap-2 rounded-md p-2 text-sm hover:bg-sidebar-accent aria-[current]:bg-sidebar-accent aria-[current]:font-medium';
---

<nav class="shell flex h-(--nav-height) items-center justify-between gap-2">
  <a class="text-[22px] leading-7 font-semibold tracking-[-.02em]" href="/">Rh45</a>
  <div class="flex items-center gap-2">
    <details class="company-menu group relative max-[620px]:hidden">
      <summary class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'cursor-pointer list-none border-input shadow-none [&::-webkit-details-marker]:hidden')}>
        Company
        <ChevronDown className="transition-transform group-open:rotate-180" />
      </summary>
      <div class="absolute top-[calc(100%+.5rem)] right-0 z-20 flex w-44 flex-col rounded-md border bg-popover p-1 text-popover-foreground shadow-md">
        {
          companyLinks.map(({ href, label }) => (
            <a class="rounded-sm px-2 py-1.5 text-sm hover:bg-accent aria-[current]:font-semibold" href={href} aria-current={path === href ? 'page' : undefined}>
              {label}
            </a>
          ))
        }
      </div>
    </details>
    <a class={cn(buttonVariants({ size: 'sm' }), 'relative after:absolute after:inset-x-0 after:-inset-y-1.5 hover:bg-muted-foreground')} href="mailto:info@rh45.ai">
      Contact Rh45
      <ArrowUpRight />
    </a>
    <button
      class={cn(buttonVariants({ variant: 'ghost', size: 'icon-sm' }), 'mobile-menu-open relative -mr-2 cursor-pointer after:absolute after:-inset-x-1 after:-inset-y-1.5 min-[621px]:hidden')}
      type="button"
      aria-label="Open navigation menu"
      aria-haspopup="dialog"
    >
      <PanelLeft />
    </button>
  </div>
</nav>

<dialog class="mobile-menu" aria-labelledby="mobile-menu-title">
  <div class="flex items-center justify-between p-4 pb-2">
    <h2 class="m-0 text-xs leading-4 font-medium tracking-normal text-muted-foreground" id="mobile-menu-title">Rh45</h2>
    <button class={cn(buttonVariants({ variant: 'ghost', size: 'icon-sm' }), 'mobile-menu-close -mr-1 cursor-pointer')} type="button" aria-label="Close navigation menu">
      <X />
    </button>
  </div>
  <ul class="flex flex-col gap-1 px-2">
    <li>
      <a class={menuItem} href="/" aria-current={path === '/' ? 'page' : undefined}>
        <House className="size-4" aria-hidden="true" />
        Home
      </a>
    </li>
    <li>
      <details class="group" open>
        <summary class={cn(menuItem, 'list-none [&::-webkit-details-marker]:hidden')}>
          <Building2 className="size-4" aria-hidden="true" />
          Company
          <ChevronRight className="ml-auto size-4 transition-transform duration-200 group-open:rotate-90" aria-hidden="true" />
        </summary>
        <ul class="mx-3.5 flex translate-x-px flex-col gap-1 border-l border-sidebar-border px-2.5 py-0.5">
          {
            companyLinks.map(({ href, label }) => (
              <li>
                <a class={menuItem} href={href} aria-current={path === href ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </li>
  </ul>
</dialog>

<style>
  .mobile-menu { position: fixed; inset: 0 0 0 auto; margin: 0; width: 18rem; max-width: 85vw; height: 100dvh; max-height: none; border: 0; border-left: 1px solid var(--sidebar-border); background: var(--sidebar); color: var(--sidebar-foreground); }
  .mobile-menu[open] { animation: menu-in .25s cubic-bezier(.16, 1, .3, 1); }
  .mobile-menu::backdrop { background: rgb(0 0 0 / .5); }
  @keyframes menu-in {
    from { transform: translateX(100%); }
  }
</style>

<script>
  const companyMenu = document.querySelector<HTMLDetailsElement>('.company-menu')!;
  const mobileMenu = document.querySelector<HTMLDialogElement>('.mobile-menu')!;

  document.querySelector('.mobile-menu-open')!.addEventListener('click', () => mobileMenu.showModal());
  document.querySelector('.mobile-menu-close')!.addEventListener('click', () => mobileMenu.close());
  // A click on the dialog element itself is a click on its backdrop.
  mobileMenu.addEventListener('click', (event) => {
    if (event.target === mobileMenu) mobileMenu.close();
  });

  document.addEventListener('click', (event) => {
    if (!companyMenu.contains(event.target as Node)) companyMenu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !companyMenu.open) return;
    companyMenu.open = false;
    companyMenu.querySelector('summary')!.focus();
  });
  window.matchMedia('(max-width: 620px)').addEventListener('change', () => {
    companyMenu.open = false;
    mobileMenu.close();
  });
  // A page restored from the back/forward cache keeps the state it was left in.
  window.addEventListener('pageshow', () => {
    companyMenu.open = false;
    mobileMenu.close();
  });
</script>
