---
import { ArrowRight, Globe } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { homePath, type Lang, otherLang, ui } from '@/i18n';
import { cn } from '@/lib/utils';

interface Props {
  lang: Lang;
  minimal?: boolean;
}

const { lang, minimal = false } = Astro.props;
const t = ui[lang];
const homeHref = homePath[lang];
const other = otherLang[lang];
const navLink = 'text-muted-foreground underline-offset-4 transition-colors duration-250 group-data-[over-block]:text-input hover:underline dark:group-data-[over-block]:text-muted-foreground';
---

<div class="site-header group sticky top-0 z-10 bg-background transition-colors duration-250 data-[over-block]:bg-primary data-[over-block]:text-primary-foreground dark:data-[over-block]:bg-secondary dark:data-[over-block]:text-foreground">
  <header class="wrap flex flex-wrap items-center justify-between gap-4 py-6">
    <a class="wordmark relative text-[26px] leading-8 font-semibold tracking-[-.02em] after:absolute after:inset-x-0 after:-inset-y-3.5" href={minimal ? homeHref : `${homeHref}#top`} aria-label={minimal ? t.home : t.backToTop}>Rh45</a>
    <nav class="flex flex-wrap items-center gap-6 text-sm max-[640px]:gap-4" aria-label={t.nav}>
      {
        !minimal &&
          t.sections.map(({ id, label }) => (
            <a class={cn(navLink, 'max-[640px]:hidden')} href={`${homeHref}#${id}`}>
              {label}
            </a>
          ))
      }
      <a class={cn(navLink, 'language-switch relative inline-flex items-center gap-1.5 after:absolute after:inset-x-0 after:-inset-y-3')} href={homePath[other]} hreflang={other} lang={other} data-lang={other}>
        <Globe className="size-4" aria-hidden="true" />
        {ui[other].languageName}
      </a>
      <a class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'relative border-input bg-transparent shadow-none after:absolute after:inset-x-0 after:-inset-y-1.5 hover:bg-current/10 hover:text-inherit dark:bg-transparent dark:hover:bg-current/10')} href={`${homeHref}#contact`}>
        {t.contact}
        <ArrowRight />
      </a>
    </nav>
  </header>
</div>

<style>
  .wordmark { text-box: trim-both cap alphabetic; }
</style>

<script>
  // The header takes the color of the contact block once it has scrolled under it.
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const contact = document.getElementById('contact');
  if (contact) {
    const update = () => header.toggleAttribute('data-over-block', contact.getBoundingClientRect().top <= 42);
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  // A language picked here is remembered, so the language prompt does not ask again.
  document.querySelector<HTMLAnchorElement>('.language-switch')!.addEventListener('click', (event) => {
    try {
      localStorage.setItem('rh45-language', (event.currentTarget as HTMLAnchorElement).dataset.lang!);
    } catch {}
  });
</script>
