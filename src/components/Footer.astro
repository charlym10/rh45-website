---
import { ArrowUpRight } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
---

<footer class="bg-footer py-12 text-sm text-footer-foreground">
  <div class="shell">
    <h2>Talk to Rh45.</h2>
    <p class="max-w-[68ch] text-base">We welcome conversations with partners, suppliers, investors and collaborators.</p>
    <a class={cn(buttonVariants({ variant: 'link' }), 'mt-2 px-0 has-[>svg]:px-0 max-[620px]:h-11 text-base text-footer-foreground underline focus-visible:ring-footer-foreground/50')} href="mailto:info@rh45.ai">info@rh45.ai <ArrowUpRight /></a>
    <div class="mt-12 flex items-center justify-between gap-6 max-[620px]:flex-col max-[620px]:items-start max-[620px]:gap-2">
      <span>Delaware Corporation · United States</span>
      <span>Copyright © 2026 Rh45 Corp. All rights reserved.</span>
    </div>
  </div>
</footer>
