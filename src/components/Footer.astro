---
import { type Lang, ui } from '@/i18n';

interface Props {
  lang: Lang;
  minimal?: boolean;
}

const { lang, minimal = false } = Astro.props;
const t = ui[lang];
---

<footer class:list={['text-sm', minimal ? 'text-muted-foreground' : 'bg-primary text-input dark:bg-secondary dark:text-muted-foreground']}>
  <div class="wrap">
    <div class:list={['flex flex-wrap justify-between gap-4 border-t', minimal ? 'pt-6 pb-8' : 'border-primary-foreground/20 pt-8 pb-12 dark:border-foreground/20']}>
      <span>{t.country}</span>
      <span>{t.copyright}</span>
    </div>
  </div>
</footer>
