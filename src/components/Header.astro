---
import { ChevronDown } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';

const companyLinks = [
  { href: '/manifesto/', label: 'Manifesto' },
  { href: '/how-we-operate/', label: 'How we operate' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="sticky top-0 z-5 bg-background">
  <nav class="shell">
    <a class="logo" href="/">Rh45</a>
    <div class="links" id="main-navigation">
      <div class="company-menu">
        <button
          class={cn(buttonVariants({ variant: 'secondary', size: 'sm' }), 'company-trigger cursor-pointer hover:bg-accent focus-visible:ring-ring')}
          type="button"
          aria-expanded="false"
          aria-controls="company-links"
        >
          Company<ChevronDown className="company-chevron" strokeWidth={1.5} aria-hidden="true" />
        </button>
        <div class="company-dropdown" id="company-links">
          {
            companyLinks.map(({ href, label }) => (
              <a href={href} aria-current={path === href ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <a class={cn(buttonVariants({ size: 'sm' }), 'contact hover:bg-muted-foreground focus-visible:ring-ring')} href="mailto:info@rh45.ai">Contact Rh45 ↗</a>
    <button
      class={cn(buttonVariants({ variant: 'secondary', size: 'icon' }), 'mobile-menu-toggle cursor-pointer hover:bg-accent focus-visible:ring-ring')}
      type="button"
      aria-label="Open navigation menu"
      aria-controls="main-navigation"
      aria-expanded="false"
    >
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="size-5">
        <path d="M3.5 5.5H16.5M3.5 10H13M3.5 14.5H9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </nav>
</header>

<style>
  nav { height: var(--nav-height); display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: .5rem; }
  .logo { justify-self: start; font-size: 22px; line-height: 28px; font-weight: 600; letter-spacing: -.02em; }
  .links { display: flex; gap: .5rem; }
  .company-menu { position: relative; display: flex; align-items: center; }
  .company-trigger :global(.company-chevron) { transition: transform .18s ease; }
  .company-menu.open > .company-trigger :global(.company-chevron) { transform: rotate(180deg); }
  .company-dropdown { display: none; position: absolute; z-index: 10; top: calc(100% + .5rem); left: 0; flex-direction: column; min-width: 190px; padding: .5rem; background: var(--popover); border: 1px solid var(--border); border-radius: var(--radius); }
  .company-menu.open > .company-dropdown { display: flex; }
  /* Bridges the gap so the menu stays open while the pointer moves down to it. */
  .company-dropdown::before { content: ""; position: absolute; left: 0; right: 0; top: calc(-.5rem - 1px); height: .5rem; }
  .company-dropdown a { padding: .5rem .75rem; border-radius: calc(var(--radius) - 2px); font-size: 14px; line-height: 20px; white-space: nowrap; }
  .company-dropdown a:hover, .company-dropdown a:focus-visible { background: var(--accent); }
  .company-dropdown a[aria-current] { font-weight: 600; }
  .contact { justify-self: end; }
  .mobile-menu-toggle { display: none; }

  @media (max-width: 620px) {
    nav { display: flex; justify-content: space-between; }
    .links { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; gap: 0; padding: 15px 1.5rem; background: var(--background); border-bottom: 1px solid var(--border); }
    .links.open { display: flex; }
    .company-menu { flex-direction: column; align-items: stretch; }
    .company-trigger, .company-trigger:hover { justify-content: space-between; width: 100%; height: auto; padding: 10px; background: none; border-radius: 0; font-size: 16px; line-height: 24px; font-weight: 400; }
    .company-dropdown { position: static; min-width: 0; margin: 0 0 6px 10px; padding: 4px 8px; background: transparent; border: 0; border-left: 1px solid var(--border); border-radius: 0; }
    .company-dropdown::before { content: none; }
    .company-dropdown a { padding: 9px 12px; font-size: .78rem; white-space: normal; }
    .contact { position: relative; height: 36px; margin-left: auto; padding: 0 12px; }
    .mobile-menu-toggle { position: relative; display: inline-flex; }
    /* Keep 44px touch targets around the smaller visible controls. */
    .contact::after, .mobile-menu-toggle::after { content: ""; position: absolute; inset: -5px; }
    .contact::after { inset: -5px -1px; }
  }
</style>

<script>
  const header = document.querySelector('header')!;
  const mobileMenuToggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle')!;
  const mainNavigation = document.querySelector<HTMLElement>('#main-navigation')!;
  const companyMenu = document.querySelector<HTMLElement>('.company-menu')!;
  const companyTrigger = document.querySelector<HTMLButtonElement>('.company-trigger')!;
  const desktopPointer = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 621px)');
  const mobileLayout = window.matchMedia('(max-width: 620px)');

  function setCompanyMenu(isOpen: boolean) {
    companyMenu.classList.toggle('open', isOpen);
    companyTrigger.setAttribute('aria-expanded', String(isOpen));
  }

  function setMobileMenu(isOpen: boolean) {
    mainNavigation.classList.toggle('open', isOpen);
    mobileMenuToggle.setAttribute('aria-expanded', String(isOpen));
    mobileMenuToggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
  }

  function closeMenus() {
    setCompanyMenu(false);
    setMobileMenu(false);
  }

  mobileMenuToggle.addEventListener('click', () => {
    const isOpen = !mainNavigation.classList.contains('open');
    setMobileMenu(isOpen);
    if (isOpen) companyTrigger.focus();
    else setCompanyMenu(false);
  });

  companyTrigger.addEventListener('click', (event) => {
    // With a mouse the menu follows hover; keyboard and touch toggle it.
    if (desktopPointer.matches && event.detail > 0) return;
    setCompanyMenu(!companyMenu.classList.contains('open'));
  });

  companyMenu.addEventListener('mouseenter', () => {
    if (desktopPointer.matches) setCompanyMenu(true);
  });
  companyMenu.addEventListener('mouseleave', () => {
    if (desktopPointer.matches && !companyMenu.querySelector(':focus-visible')) setCompanyMenu(false);
  });
  companyMenu.addEventListener('focusout', (event) => {
    if (!companyMenu.contains(event.relatedTarget as Node | null) && !companyMenu.matches(':hover')) setCompanyMenu(false);
  });

  header.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenus));

  document.addEventListener('click', (event) => {
    if (!header.contains(event.target as Node)) closeMenus();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const focusInMenu = companyMenu.contains(document.activeElement);
    const mobileOpen = mainNavigation.classList.contains('open');
    closeMenus();
    if (mobileOpen) mobileMenuToggle.focus();
    else if (focusInMenu) companyTrigger.focus();
  });

  mobileLayout.addEventListener('change', closeMenus);
  // A page restored from the back/forward cache keeps the state it was left in.
  window.addEventListener('pageshow', closeMenus);
</script>
